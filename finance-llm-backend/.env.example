# Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# Flask Configuration
# ============================================================================
FLASK_APP=app.py
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=your-secret-key-change-in-production

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# Ollama/LLM Configuration
# ============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b
OLLAMA_TIMEOUT=120

# ============================================================================
# Embedding Model Configuration
# ============================================================================
EMBEDDING_MODEL=intfloat/e5-large-v2

# ============================================================================
# Chunking Configuration
# ============================================================================
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ============================================================================
# Retrieval Configuration
# ============================================================================
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.5

# ============================================================================
# Redis Configuration (for chat history)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SESSION_TTL=3600
REDIS_MAX_HISTORY=10

# ============================================================================
# Upload Configuration
# ============================================================================
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216

# Supabase PostgreSQL Configuration (pgvector)
# Get these from: Supabase Dashboard → Settings → Database
SUPABASE_DB_HOST=db.xxxxxxxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-password-here
SUPABASE_DB_SSLMODE=require

# Alternatively, use a single connection string
# Get this from: Supabase Dashboard → Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
